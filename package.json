{
  "name": "employee-onboarding-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "seed": "npm --prefix server run seed"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
